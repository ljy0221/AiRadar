# Server1 public / private access
SERVER1_PUBLIC_HOST=j14b104.p.ssafy.io
SERVER2_PRIVATE_HOST=172.26.5.50
SERVER2_POSTGRES_PORT=15432
SERVER2_REDIS_PORT=16379
SERVER2_AI_SERVER_PORT=18000
AI_SERVER_URL=http://172.26.5.50:18000

# Published ports on Server1
KAFKA_INTERNAL_PORT=19092
KAFKA_EXTERNAL_PORT=29092
SPARK_MASTER_PORT=17077
SPARK_MASTER_UI_PORT=18080
SPARK_APP_UI_PORT=14040
CRAWLER_PORT=18002
AIRFLOW_PORT=18081
JENKINS_PORT=18083
JENKINS_AGENT_PORT=15000

# Shared data / DB identifiers
POSTGRES_DB=airadar
POSTGRES_USER=airadar
POSTGRES_PASSWORD=change-me

# Airflow metadata DB account (stored in Server2 PostgreSQL)
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=change-me

# Spark worker sizing
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=4g
AI_SERVER_CONCURRENCY=20
AI_BATCH_SIZE=10

# Airflow
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_LOAD_EXAMPLES=False
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# Crawler -> Kafka
CRAWLER_KAFKA_TOPIC_PREFIX=airader.raw
CRAWLER_KAFKA_CLIENT_ID=airader-crawler
CRAWLER_KAFKA_ACKS=all
CRAWLER_KAFKA_RETRIES=3
CRAWLER_KAFKA_LINGER_MS=50
CRAWLER_KAFKA_REQUEST_TIMEOUT_MS=15000
CRAWLER_TIMEOUT_SEC=15
CRAWLER_DELAY_SEC=1.0

# Optional credentials
GITHUB_TOKEN=

# External S3 storage
RAW_S3_BUCKET=airadar-delta
BRONZE_BASE_PATH=s3a://airadar-delta/bronze
SILVER_BASE_PATH=s3a://airadar-delta/silver
S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
