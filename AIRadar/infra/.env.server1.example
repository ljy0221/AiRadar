# Kafka external access
SERVER1_PUBLIC_HOST=your-server-ip-or-dns

# Spark worker sizing
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=4g

# Crawler Kafka settings
CRAWLER_KAFKA_TOPIC_PREFIX=airader.raw
CRAWLER_KAFKA_CLIENT_ID=airader-crawler
CRAWLER_KAFKA_ACKS=all
CRAWLER_KAFKA_RETRIES=3
CRAWLER_KAFKA_LINGER_MS=50
CRAWLER_KAFKA_REQUEST_TIMEOUT_MS=15000
CRAWLER_TIMEOUT_SEC=15
CRAWLER_DELAY_SEC=1.0

# Optional credentials
GITHUB_TOKEN=

# Reserved for later S3 integration
RAW_S3_BUCKET=
BRONZE_BASE_PATH=
SILVER_BASE_PATH=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
