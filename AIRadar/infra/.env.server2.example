# Cross-server access to Server1
SERVER1_PRIVATE_HOST=server1-private-ip-or-dns
SERVER1_SPARK_MASTER_PORT=17077
SERVER1_KAFKA_EXTERNAL_PORT=29092

# Published ports on Server2
SPARK_WORKER2_UI_PORT=18082
POSTGRES_PUBLISHED_PORT=15432
REDIS_PUBLISHED_PORT=16379
AI_SERVER_PORT=18000
BACKEND_PORT=18888
FRONTEND_PORT=13000
KAFKA_UI_PORT=18090
PGADMIN_PORT=18050
REDIS_INSIGHT_PORT=18001

# Frontend / Backend
SPRING_PROFILES_ACTIVE=prod
NEXT_PUBLIC_API_BASE_URL=http://your-server2-host:18888

# Spark worker sizing
SPARK_WORKER2_CORES=2
SPARK_WORKER2_MEMORY=4g
AI_SERVER_CONCURRENCY=20
AI_BATCH_SIZE=10

# Shared data / DB identifiers
POSTGRES_DB=airadar
POSTGRES_USER=airadar
POSTGRES_PASSWORD=change-me

# Airflow metadata DB account created in Server2 PostgreSQL
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=change-me

# AI server
GMS_KEY=

# GUI admin accounts
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# External S3 storage
BRONZE_BASE_PATH=s3a://airadar-delta/bronze
SILVER_BASE_PATH=s3a://airadar-delta/silver
S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
