# Cross-server access to server1
SERVER1_PRIVATE_HOST=server1-private-ip-or-dns
SERVER1_SPARK_MASTER_PORT=17077
SERVER1_AI_SERVER_PORT=18000
SERVER1_POSTGRES_PORT=15432

# Published ports
SPARK_WORKER2_UI_PORT=18082

# Spark worker sizing
SPARK_WORKER2_CORES=2
SPARK_WORKER2_MEMORY=4g
AI_SERVER_CONCURRENCY=20
AI_BATCH_SIZE=10

# Shared storage / database access
POSTGRES_DB=airadar
POSTGRES_USER=airadar
POSTGRES_PASSWORD=change-me
BRONZE_BASE_PATH=s3a://airadar-delta/bronze
SILVER_BASE_PATH=s3a://airadar-delta/silver
S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
