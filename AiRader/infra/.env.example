# ───────────────────────────────────────────────────────────────────────────────
# AiRader 로컬 개발 환경 설정 템플릿
# 사용법: cp .env.example .env  →  .env 파일에서 비밀번호 변경 후 사용
# ⚠️  .env 파일은 절대 커밋하지 않는다 (.gitignore에 포함됨)
# ───────────────────────────────────────────────────────────────────────────────

# ── MinIO (로컬 S3-compatible 스토리지) ─────────────────────────────────────────
# Delta Lake Bronze/Silver 레이어를 저장하는 스토리지
# Console UI: http://localhost:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ── PostgreSQL (Gold 레이어 + Airflow 메타DB) ────────────────────────────────────
# 서비스 DB (public 스키마): tech_news_service, news_items, papers, github_repos
POSTGRES_DB=airader
POSTGRES_USER=airader
POSTGRES_PASSWORD=airader_secret

# Airflow 메타DB (airflow 스키마, postgres-init 컨테이너가 자동 생성)
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=airflow_secret

# ── Airflow ───────────────────────────────────────────────────────────────────
# airflow.env에서 관리되나 override가 필요한 경우 여기서 설정
# AIRFLOW_ADMIN_USERNAME=admin
# AIRFLOW_ADMIN_PASSWORD=your_password
